{
  "name": "sanskrit-teaching-web-app-from-beginner-to-advanced-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-seo-html.mjs",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "optimize:images": "python3 scripts/optimize-images.py",
    "razorpay:local": "node scripts/razorpay-subscribe-server.mjs",
    "deploy:pages": "GITHUB_PAGES=true npm run build && npx gh-pages -d dist",
    "deploy:cloudflare": "GITHUB_PAGES='' GH_PAGES='' npm run build && rm -f dist/wrangler.json && rm -rf .wrangler/deploy && wrangler pages deploy dist --project-name sanskrit-teaching-web-app --branch main",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "wrangler": "^4.148.0"
  }
}
