# Password reset emails — Vercel serverless + Resend (NOT EmailJS)
# Server-only (set in Vercel → Project → Settings → Environment Variables):
#   RESEND_API_KEY=re_...          (required for /api/send-reset-otp)
#   RESEND_FROM_EMAIL=EdNet Learn <beth.t@example.com>
#     After verifying ednetlearn.in in Resend, switch to:
#     RESEND_FROM_EMAIL=EdNet Learn <care@ednetlearn.in>
#
# Client (optional):
# VITE_RESET_API_URL=              # empty = same-origin /api/send-reset-otp (preferred on Vercel)
# VITE_RESET_EMAIL_ENABLED=false   # force-disable reset emails (e.g. local testing)
#
# Deprecated for password reset (do not use):
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Razorpay Standard Checkout — ONE-TIME order (PUBLIC Key ID only)
# Key Secret must NEVER appear here or in src/. Use Worker secret / process.env only.
VITE_RAZORPAY_KEY_ID=rzp_test_TemQRGluBPDb0O
VITE_RAZORPAY_PLAN_ID=plan_TemGs0Xzlbqpu6
# order (default) = one-time ₹200 | subscription = unused scaffolding
VITE_RAZORPAY_CHECKOUT_MODE=order
# Cloudflare Worker URL after deploy, or http://127.0.0.1:8787 for local script
VITE_RAZORPAY_API_URL=https://razorpay-subscribe.ednetlearn.workers.dev
